{
  "name": "schoolpalm/module-sdk",
  "description": "Official SDK for building SchoolPalm modules",
  "type": "library",
  "version":"1.0.0",
  "license": "MIT",
  "authors": [
    {
      "name": "Hassan Mugabo",
      "email": "cybarox@gmail.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "SchoolPalm\\ModuleSDK\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "SchoolPalm\\ModuleSDK\\ModuleServiceProvider"
      ]
    }
  },

  "repositories": [
    {
      "type": "path",
       "url": "E:/dev-server/www/packages/schoolpalm-module-bridge",
      "options": {
        "symlink": true
      }
    }
  ],

  "require": {
    "php": "^8.2",
    "illuminate/support": "^12.0",
    "illuminate/console": "^12.0",
    "opis/json-schema": "^2.6",
    "inertiajs/inertia-laravel": "^2.0",
    "schoolpalm/module-bridge": "^1.3"
  },

  "suggest": {
    "@inertiajs/inertia-vue3": "JS Vue3 adapter for Inertia",
    "vue": "Vue3 for module frontend",
    "quasar": "Quasar framework for UI components"
  }
}
