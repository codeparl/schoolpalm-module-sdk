<template>
  <div class="q-pa-md">
    <q-card class="q-pa-md">
      <div class="text-h6 q-mb-md">Create {{ dtoName }}</div>
      <q-form @submit="submit">
        {{ form_fields }}
        <q-btn
          label="Create"
          type="submit"
          color="primary"
          class="q-mt-md"
          :loading="loading"
          :disable="loading"
        />
      </q-form>
    </q-card>
  </div>
</template>

<script setup lang="ts">
import { ref } from 'vue'
import { useQuasar } from 'quasar'
import axios, { AxiosError } from 'axios'

interface FormData {
  [key: string]: any
}

const $q = useQuasar()
const loading = ref(false)
const form = ref<FormData>({})

const submit = async () => {
  loading.value = true
  try {
    const method = '{{ method }}'.toLowerCase() as 'get' | 'post' | 'put' | 'patch' | 'delete'
    if (method === 'get') {
      await axios.get('{{ store_route }}', { params: form.value })
    } else {
      await axios[method]('{{ store_route }}', form.value)
    }
    $q.notify({
      type: 'positive',
      message: 'Created successfully',
      position: 'top',
      timeout: 3000
    })
  } catch (error) {
    const err = error as AxiosError<{ message?: string }>
    $q.notify({
      type: 'negative',
      message: err.response?.data?.message || 'Creation failed',
      position: 'top',
      timeout: 4000
    })
  } finally {
    loading.value = false
  }
}
</script>