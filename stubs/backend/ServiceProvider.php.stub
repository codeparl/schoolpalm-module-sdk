<?php

namespace {{ namespace }};

use Illuminate\Support\ServiceProvider;
use Illuminate\Support\Facades\File;

class {{ class }} extends ServiceProvider
{
    public function register(): void
    {
        $this->bindFromFolders(
            "{{ module_namespace }}"
        );
    }

    protected function bindFromFolders(string $moduleNamespace): void
    {
        $providerReflection = new \ReflectionClass($this);

        $providerPath = dirname(
            $providerReflection->getFileName()
        );

        $modulePath = realpath(
            $providerPath . DIRECTORY_SEPARATOR . '..'
        );

        if (!$modulePath) {
            return;
        }

        $this->bindPublicContracts(
            $modulePath,
            $moduleNamespace
        );

        $this->bindCoreContracts(
            $modulePath,
            $moduleNamespace
        );
    }

    /**
     * Bind public contracts (Contracts/*) to services (Services/*)
     */
    protected function bindPublicContracts(
        string $modulePath,
        string $moduleNamespace
    ): void {
        $contractsPath = $modulePath . DIRECTORY_SEPARATOR . 'Contracts';
        $servicesPath  = $modulePath . DIRECTORY_SEPARATOR . 'Services';

        if (!is_dir($contractsPath) || !is_dir($servicesPath)) {
            return;
        }

        foreach (File::allFiles($contractsPath) as $contractFile) {
            // Skip files in subdirectories (like Core)
            if ($contractFile->getRelativePath() !== '') {
                continue;
            }

            $contractClass = pathinfo($contractFile, PATHINFO_FILENAME);

            // Skip if not a contract (must end with 'Contract')
            if (!str_ends_with($contractClass, 'Contract')) {
                continue;
            }

            $serviceClass = str_replace('Contract', 'Service', $contractClass);
            $serviceFile = $servicesPath . DIRECTORY_SEPARATOR . $serviceClass . '.php';

            if (!file_exists($serviceFile)) {
                continue;
            }

            $abstract = $moduleNamespace . '\\Contracts\\' . $contractClass;
            $concrete = $moduleNamespace . '\\Services\\' . $serviceClass;

            $this->app->bind($abstract, $concrete);
        }
    }

    /**
     * Bind core contracts (Contracts/Core/*) to core services (Services/Core/*)
     */
    protected function bindCoreContracts(
        string $modulePath,
        string $moduleNamespace
    ): void {
        $contractsPath = $modulePath . DIRECTORY_SEPARATOR . 'Contracts' . DIRECTORY_SEPARATOR . 'Core';
        $servicesPath  = $modulePath . DIRECTORY_SEPARATOR . 'Services' . DIRECTORY_SEPARATOR . 'Core';

        if (!is_dir($contractsPath) || !is_dir($servicesPath)) {
            return;
        }

        foreach (File::allFiles($contractsPath) as $contractFile) {
            $contractClass = pathinfo($contractFile, PATHINFO_FILENAME);
            $serviceClass = str_replace('Contract', 'Service', $contractClass);
            $serviceFile = $servicesPath . DIRECTORY_SEPARATOR . $serviceClass . '.php';

            if (!file_exists($serviceFile)) {
                continue;
            }

            $abstract = $moduleNamespace . '\\Contracts\\Core\\' . $contractClass;
            $concrete = $moduleNamespace . '\\Services\\Core\\' . $serviceClass;

            $this->app->bind($abstract, $concrete);
        }
    }
}